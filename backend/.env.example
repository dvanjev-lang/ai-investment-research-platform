# Data provider: "mock" works without any external APIs
DATA_PROVIDER=mock

# Optional: enables GPT-4o analysis and real embeddings
OPENAI_API_KEY=

# Optional: only needed if using live financial data
FMP_API_KEY=
ALPHA_VANTAGE_KEY=

# Required for production auth (change this)
APP_SECRET_KEY=change-me-in-production

# Only needed if connecting a real PostgreSQL database
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/dbname
